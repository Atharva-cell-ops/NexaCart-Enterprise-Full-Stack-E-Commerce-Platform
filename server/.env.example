# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite file for local development or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/nexacart?schema=public"

# Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
